<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Bez LegAid.Eval.exe: Smart App Control w Windows blokuje niepodpisane exe, dotnet run startuje wtedy przez dotnet.exe -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <None Update="cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
